diff --git a/crates/rustsheet-engine/examples/t3963_probe.rs b/crates/rustsheet-engine/examples/t3963_probe.rs
new file mode 100644
index 000000000..2835426ba
--- /dev/null
+++ b/crates/rustsheet-engine/examples/t3963_probe.rs
@@ -0,0 +1,17 @@
+use rustsheet_engine::{cell::CellValue, Model};
+use std::io::BufRead;
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    for line in std::io::stdin().lock().lines() {
+        let f = line?;
+        let mut m = Model::new_empty("p", "en", "UTC", "en")?;
+        m.set_user_input(0, 1, 1, f.clone())?;
+        m.evaluate();
+        let v = match m.get_cell_value_by_index(0, 1, 1)? {
+            CellValue::Number(x) => format!("{x:?}"),
+            o => format!("E:{o:?}"),
+        };
+        println!("{v}");
+    }
+    Ok(())
+}
